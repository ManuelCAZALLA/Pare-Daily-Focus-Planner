    "Planifica tus tareas diarias y mantén el foco en lo que realmente importa con una vista de línea de tiempo." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطط لمهامك اليومية واستمر في التركيز على ما يهم حقًا من خلال عرض الجدول الزمني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planen Sie Ihre täglichen Aufgaben und konzentrieren Sie sich mit der Zeitleistenansicht auf das Wesentliche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan your daily tasks and keep focus on what truly matters with a timeline view."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez vos tâches quotidiennes et restez concentré sur ce qui compte vraiment grâce à une vue chronologique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
